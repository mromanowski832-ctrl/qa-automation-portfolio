<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="LuzMen UI Regression Suite"
       parallel="classes"
       thread-count="2"
       data-provider-thread-count="2"
       verbose="1">

    <listeners>
        <listener class-name="pl.luzmen.qa.listeners.TestListener"/>
    </listeners>

    <test name="SauceDemo Regression">
        <classes>
            <class name="pl.luzmen.qa.tests.LoginTests"/>
            <class name="pl.luzmen.qa.tests.InventoryTests"/>
            <class name="pl.luzmen.qa.tests.PurchaseFlowTests"/>
        </classes>
    </test>
</suite>
